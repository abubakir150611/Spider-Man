# AI Content Factory — секреты. Скопируйте в .env и заполните. .env не попадает в git.

# Telegram Bot API (обязательно для публикации)
# Токен выдаёт @BotFather (/newbot). Никогда не публикуйте его.
TELEGRAM_BOT_TOKEN=
# @username публичного канала или числовой id (-100...) приватного
TELEGRAM_CHANNEL_ID=

# Необязательно: собственный Bot API сервер (лимит загрузки до 2 ГБ вместо 50 МБ)
# TELEGRAM_API_BASE=http://localhost:8081
# TELEGRAM_MAX_UPLOAD_MB=1950

# Необязательно: принудительно выбрать TTS-движок (edge | piper | mms | espeak)
# CF_TTS_PROVIDER=
# Необязательно: другой голос Edge, например ru-RU-SvetlanaNeural или en-US-AvaNeural
# CF_EDGE_VOICE=
# Необязательно: путь к Chrome/Chromium для рендера и скриншотов
# CF_BROWSER=
# Необязательно: число потоков рендера Remotion
# CF_CONCURRENCY=
